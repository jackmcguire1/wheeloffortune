# Connect API served by cmd/server
VITE_API_URL=http://localhost:7755

# Firebase. The "demo-" project id means no real Firebase project is needed.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_PROJECT_ID=demo-wheeloffortune

# Auth emulator URL. Set to an empty value to use real Firebase Auth.
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
